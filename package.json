{
  "name": "bitcoin-strategy-protocol",
  "version": "0.1.0",
  "description": "BTC Strategy Protocol Testnet MVP smart contracts",
  "license": "MIT",
  "scripts": {
    "bond:smoke:localhost": "hardhat run scripts/bond-smoke.ts --network localhost",
    "bond:smoke:robinhood:testnet": "hardhat run scripts/bond-smoke.ts --network robinhoodTestnet",
    "bond:smoke:sepolia": "hardhat run scripts/bond-smoke.ts --network sepolia",
    "check:venue:robinhood": "hardhat run scripts/check-swap-venue.ts --network robinhood",
    "check:venue:robinhood:testnet": "hardhat run scripts/check-swap-venue.ts --network robinhoodTestnet",
    "build": "run-s clean compile",
    "build:test": "run-s build test",
    "clean": "hardhat clean",
    "codestyle": "run-s lint:sol format:ts format:sol",
    "codestyle:fix": "run-s lint:sol:fix format:ts:fix format:sol:fix",
    "compile": "hardhat compile",
    "coverage": "cross-env SOLIDITY_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.json",
    "deploy:fork": "cross-env FORKING_NETWORK=sepolia DEPLOYMENT=fork-sepolia DEPLOY_PROFILE=demo UNISWAP_V4_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543 hardhat run scripts/deploy.ts",
    "deploy:fork:robinhood": "cross-env FORKING_NETWORK=robinhood DEPLOYMENT=fork-robinhood DEPLOY_PROFILE=prod UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951 hardhat run scripts/deploy.ts",
    "deploy:localhost": "cross-env DEPLOY_PROFILE=demo hardhat run scripts/deploy-localhost.ts --network localhost",
    "deploy:robinhood": "cross-env hardhat run scripts/deploy.ts --network robinhood",
    "deploy:robinhood:testnet": "cross-env DEPLOY_PROFILE=demo UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951 hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "deploy:robinhood:sim": "cross-env DEPLOY_PROFILE=sim UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951 hardhat run scripts/deploy.ts --network robinhoodTestnet",
    "simulate:robinhood": "cross-env DEPLOY_PROFILE=sim UNISWAP_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951 hardhat run scripts/simulate.ts --network robinhoodTestnet",
    "post:migration:robinhood": "hardhat run scripts/post-migration.ts --network robinhood",
    "post:migration:robinhood:testnet": "hardhat run scripts/post-migration.ts --network robinhoodTestnet",
    "plan:cca:robinhood": "hardhat run scripts/plan-cca.ts --network robinhood",
    "check:cca-gate": "cross-env FORKING_NETWORK=robinhood DEPLOYMENT=fork-cca-gate hardhat run scripts/check-cca-gate.ts",
    "rehearse": "hardhat run scripts/rehearse.ts",
    "live:check:robinhood:testnet": "hardhat run scripts/live-check.ts --network robinhoodTestnet",
    "mint:btc:robinhood:testnet": "hardhat run scripts/mint-btc.ts --network robinhoodTestnet",
    "deploy:sepolia": "cross-env DEPLOY_PROFILE=demo hardhat run scripts/deploy.ts --network sepolia",
    "deploy:sepolia:prod": "cross-env DEPLOY_PROFILE=prod hardhat run scripts/deploy.ts --network sepolia",
    "format:sol": "prettier \"contracts/**/*.sol\" --check",
    "format:sol:fix": "prettier \"contracts/**/*.sol\" --write",
    "format:ts": "prettier \"**/*.{js,ts,json}\" --check",
    "format:ts:fix": "prettier \"**/*.{js,ts,json}\" --write",
    "fund:treasury": "hardhat run scripts/fund-treasury.ts --network sepolia",
    "genesis:finalize:sepolia": "cross-env CONFIRM=yes hardhat run scripts/finalize-genesis.ts --network sepolia",
    "genesis:finalize:robinhood": "hardhat run scripts/finalize-genesis.ts --network robinhood",
    "genesis:finalize:robinhood:testnet": "hardhat run scripts/finalize-genesis.ts --network robinhoodTestnet",
    "admin:transfer:localhost": "hardhat run scripts/transfer-admin.ts --network localhost",
    "admin:transfer:robinhood": "hardhat run scripts/transfer-admin.ts --network robinhood",
    "admin:transfer:robinhood:testnet": "hardhat run scripts/transfer-admin.ts --network robinhoodTestnet",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint \"contracts/**/*.sol\" --quiet --fix",
    "lint:ts": "eslint \"**/*.{js,ts}\"",
    "lint:ts:fix": "eslint \"**/*.{js,ts}\" --fix",
    "oracle:status:localhost": "hardhat run scripts/oracle-status.ts --network localhost",
    "oracle:status:robinhood:testnet": "hardhat run scripts/oracle-status.ts --network robinhoodTestnet",
    "oracle:status:robinhood": "hardhat run scripts/oracle-status.ts --network robinhood",
    "oracle:status:sepolia": "hardhat run scripts/oracle-status.ts --network sepolia",
    "seed:localhost": "hardhat run scripts/seed-pools.ts --network localhost",
    "seed:robinhood:testnet": "hardhat run scripts/seed-pools.ts --network robinhoodTestnet",
    "seed:sepolia": "hardhat run scripts/seed-pools.ts --network sepolia",
    "usdg:pool:localhost": "hardhat run scripts/deploy-usdg-pool.ts --network localhost",
    "usdg:pool:robinhood:testnet": "hardhat run scripts/deploy-usdg-pool.ts --network robinhoodTestnet",
    "series:create:localhost": "hardhat run scripts/create-series.ts --network localhost",
    "series:create:robinhood:testnet": "hardhat run scripts/create-series.ts --network robinhoodTestnet",
    "series:create:robinhood": "hardhat run scripts/create-series.ts --network robinhood",
    "series:create:sepolia": "hardhat run scripts/create-series.ts --network sepolia",
    "test": "hardhat test",
    "test:e2e": "hardhat test test/Integration/protocol.e2e.test.ts",
    "upgrade": "hardhat run scripts/upgrade.ts",
    "upgrades:snapshot": "hardhat run scripts/upgrades-snapshot.ts",
    "validate:upgrades": "hardhat compile && npx @openzeppelin/upgrades-core validate artifacts/build-info --exclude \"contracts/mocks/**/*.sol\"",
    "verify:dry:fork": "cross-env VERIFY_DRY_RUN=1 DEPLOYMENT=fork-sepolia hardhat run scripts/verify.ts",
    "verify:dry:localhost": "cross-env VERIFY_DRY_RUN=1 hardhat run scripts/verify.ts --network localhost",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "verify:robinhood": "hardhat run scripts/verify.ts --network robinhood",
    "verify:robinhood:testnet": "hardhat run scripts/verify.ts --network robinhoodTestnet",
    "verify:dry:robinhood:testnet": "cross-env VERIFY_DRY_RUN=1 hardhat run scripts/verify.ts --network robinhoodTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@openzeppelin/upgrades-core": "^1.46.0",
    "@types/chai-as-promised": "^7.1.8",
    "@uniswap/v3-sdk": "^3.27.0",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "hardhat": "^2.24.3",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-docgen": "^1.3.0",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^5.1.0",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0",
    "zod": "^3.22.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "dotenv": "^17.2.3",
    "solady": "^0.1.26"
  }
}